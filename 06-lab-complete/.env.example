# ============================================================
# Biến môi trường của agent. KHÔNG ghi secret thật vào file này.
# Dùng local: cp .env.example .env  (.env đã nằm trong .gitignore), rồi điền giá trị.
# Trên Railway/Render: đặt các biến này ở dashboard.
# ============================================================

# Server
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
# Số uvicorn worker trong container
WEB_CONCURRENCY=2

# Bắt buộc — client gửi trong header X-API-Key. Sinh key: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_KEY=

# State store (rate limit + cost guard). docker compose tự đặt redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0
REDIS_TIMEOUT_SECONDS=1

# Rate limit: số request tối đa / 60 giây cho mỗi API key
RATE_LIMIT_PER_MINUTE=10

# Cost guard (USD): vượt ngân sách → 402
DAILY_BUDGET_USD=1
MONTHLY_BUDGET_USD=10
